<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LOTERIAMX1</AssemblyName>
    <RootNamespace>LOTERIAMX1</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>kikivallesteros-cyber</Authors>
    <Description>Lotería Mexicana - Juego Digital Multijugador</Description>
    <PackageProjectUrl>https://github.com/kikivallesteros-cyber/LOTERIAMX1</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kikivallesteros-cyber/LOTERIAMX1</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
  </ItemGroup>

</Project>
